{
  "name": "@local-llm/web",
  "version": "0.1.0",
  "description": "Detect the Local LLM extension (or Chrome's native Prompt API) and fall back gracefully",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/index.js && tsc -p tsconfig.json"
  },
  "license": "MIT"
}
